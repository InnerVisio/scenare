# Zkopíruj do .env.local a doplň. Skutečná tajemství nikdy necommituj.

# Databáze. Nevyplněno nebo "pglite:<složka>" = lokální vestavěná databáze (výchozí .data/pglite).
# Pro skutečný Postgres: postgres://uzivatel:heslo@host:5432/databaze
DATABASE_URL=pglite:.data/pglite

# Tajný klíč pro podepisování relací a přihlašovacích odkazů (min. 32 znaků)
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# Veřejná adresa aplikace (odkazy v e-mailech). Na Vercelu je volitelná: odvodí se
# z VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL. Nastav ji jen pro vlastní doménu.
APP_URL=http://localhost:3000

# Odesílání e-mailů přes Resend (bez klíče se e-maily jen vypisují do konzole)
RESEND_API_KEY=
MAIL_FROM=Scénáře <scenare@example.com>

# Vývojové přihlášení bez e-mailu (jen lokálně, v produkci nesmí být true)
ALLOW_DEV_LOGIN=true

# Jen Vercel build: SEED_DEMO=1 po migraci nahraje ukázková data (seed je idempotentní
# a nikdy nepřepisuje úpravy).
SEED_DEMO=
